{
	"name": "alrein-ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm registry:build && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"registry:build": "shadcn-svelte registry build registry.json -o static/r",
		"registry:check": "node scripts/check-registry.mjs",
		"bans:check": "node scripts/check-bans.mjs",
		"consumer:smoke": "node scripts/consumer-smoke.mjs",
		"layout:check": "node scripts/check-layout-safety.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"supersets:check": "node scripts/check-supersets.mjs"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.34.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.3.0",
		"clsx": "^2.1.1",
		"shadcn-svelte": "^1.5.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.11"
	},
	"packageManager": "pnpm@11.23.0",
	"dependencies": {
		"@internationalized/date": "^3.12.3",
		"bits-ui": "^2.19.0"
	}
}
