		{
			"name": "theme",
			"type": "registry:theme",
			"title": "alrein-ui Theme",
			"description": "Motion scale and effect tokens for alrein-ui. Adds the --transition-duration-*, --ease-fx-*, --fx-* and semantic state values on top of the shadcn-svelte token set, plus the `sq` squircle utility, and wires the stylesheet into your app.css. Every other alrein-ui item depends on this.",
			"css": {
				"@import \"./lib/styles/alrein/index.css\"": {}
			},
			"registryDependencies": [],
			"files": [
				{
					"path": "src/lib/styles/alrein/fx.css",
					"type": "registry:file",
					"target": "~/src/lib/styles/alrein/fx.css"
				},
				{
					"path": "src/lib/styles/alrein/index.css",
					"type": "registry:file",
					"target": "~/src/lib/styles/alrein/index.css"
				},
